# Port for the Express API (default 3001)
PORT=3001

# The entire contents of the service account JSON key file, as a single line.
# Download this from Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"attendance-sa@your-project.iam.gserviceaccount.com"}

# ID of the Google Drive folder that has been shared with the service account
# email (Editor role). Found in the folder URL:
# https://drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_FOLDER_ID=your-folder-id-here
